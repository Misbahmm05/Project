import pendulum
from datetime import datetime
from airflow.sdk import DAG, task

with DAG(
    dag_id="date_time_dag",
    start_date=pendulum.datetime(2026, 1, 1, tz="Asia/Kolkata"),
    schedule="30 9 * * 3",
    catchup=False,
) as dag:

    @task
    def display_date_time():
        print("Current Date and Time:", datetime.now())

    display_date_time()

    airflow dags list
